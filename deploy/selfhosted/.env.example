# Self-hosted Weave Router environment template for deploy/selfhosted/docker-compose.yml.
# Every value without a default must be set before the first start; compose
# refuses to start while one is missing. See docs/SELF_HOSTED.md.

# --- Mode -----------------------------------------------------------------------
# standalone: bundled Postgres and Pub/Sub emulator. Leave empty when linked to a
# self-hosted Weave app (the router then uses Weave's Postgres and emulator).
COMPOSE_PROFILES=standalone
# false hides /ui and /admin/v1 when a linked Weave app manages the router.
ROUTER_UI_ENABLED=true

# --- Release (filled in by the router release; do not edit) ---------------------
ROUTER_IMAGE=
CLASSIFIER_IMAGE=
MIGRATE_IMAGE=
POLICY_IMAGE=
PUBSUB_EMULATOR_IMAGE=
CLASSIFIER_IMAGE_DIGEST=
CLASSIFIER_LOCAL_PACKAGE_SHA256=
ROUTER_SERVING_TARGET=
ROUTER_SERVING_PROJECT=
ROUTER_SERVING_REGION=
ROUTER_SERVING_REVISION=
ROUTER_SERVING_IMAGE_DIGEST=
ROUTER_SERVING_CONFIGURATION_URI=
ROUTER_SERVING_CONFIGURATION_SHA256=
ROUTER_SERVING_CONFIGURATION_GENERATION=
ROUTER_SERVING_SELECTION_SET_URI=
ROUTER_SERVING_SELECTION_SET_SHA256=
ROUTER_SERVING_SELECTION_SET_GENERATION=

# --- Database -------------------------------------------------------------------
# Standalone: the bundled Postgres password. Pick once; changing it later means
# changing it inside Postgres too.
ROUTER_POSTGRES_PASSWORD=
# Standalone: postgres://router:<ROUTER_POSTGRES_PASSWORD>@postgres:5432/router?sslmode=disable
# Linked: postgres://router-user:<ROUTER_POSTGRES_PASSWORD>@postgres:5432/<weave db>?sslmode=disable
# URL-encode the password. The migrate container appends search_path=router.
DATABASE_URL=

# --- Secrets --------------------------------------------------------------------
# Tink AES-256-GCM keyset (JSON) encrypting customer provider keys at rest.
# Linked: the same value as the Weave app's EXTERNAL_KEY_ENCRYPTION_KEY.
EXTERNAL_KEY_ENCRYPTION_KEY=
# Dashboard password for /ui. Leave empty when ROUTER_UI_ENABLED=false.
ROUTER_ADMIN_PASSWORD=
ROUTER_COOKIE_INSECURE=false
# Linked: the same value as the Weave app's WEAVE_ROUTER_INTERNAL_TOKEN.
ROUTER_INTERNAL_SERVICE_TOKEN=

# --- Pub/Sub --------------------------------------------------------------------
# Linked: the Weave app's emulator, for example pubsub-emulator:8085.
PUBSUB_EMULATOR_HOST=pubsub-emulator:8085
PUBSUB_PROJECT_ID=router-local

# --- Telemetry (linked: the Weave app's ingest endpoint) ------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
# Linked: x-router-token=<ROUTER_INGEST_TOKEN>
OTEL_EXPORTER_OTLP_HEADERS=

# --- Network --------------------------------------------------------------------
# Defaults to loopback; put a TLS proxy in front, or set 0.0.0.0 deliberately.
ROUTER_BIND_ADDRESS=127.0.0.1
ROUTER_PORT=8080

# --- Provider keys --------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=

# --- Classifier embeddings (gemini-embedding-2) ---------------------------------
# One of: a Gemini API key, or Vertex AI in your own project (leave
# GEMINI_API_KEY empty). An empty HMM_GEMINI_TRANSPORT uses the API key when one
# is set and Vertex otherwise. For Vertex outside a GCP VM, put a service-account
# key in HMM_VERTEX_CREDENTIALS_DIR and set HMM_VERTEX_CREDENTIALS_FILE to its
# path in the container, for example /vertex-credentials/key.json.
GEMINI_API_KEY=
HMM_GEMINI_TRANSPORT=
HMM_VERTEX_PROJECT=
HMM_VERTEX_LOCATION=
HMM_VERTEX_CREDENTIALS_DIR=./vertex-credentials
HMM_VERTEX_CREDENTIALS_FILE=

# --- Routing and resources ------------------------------------------------------
ROUTER_DEFAULT_STRATEGY=hmm_embedding
HMM_INFER_DEADLINE_SECONDS=10
ROUTER_HMM_SIDECAR_TIMEOUT_MS=11000
ROUTER_HMM_SIDECAR_ATTEMPT_TIMEOUT_MS=10500
ROUTER_MEM_LIMIT=4g
CLASSIFIER_MEM_LIMIT=4g
