{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "paths": {
      "@mariozechner/pi-ai": ["./node_modules/@mariozechner/pi-ai/dist/compat.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
